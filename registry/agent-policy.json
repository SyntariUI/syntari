{
  "$id": "https://syntariui.giovanitier.com/registry/agent-policy.json",
  "version": "0.4.0",
  "screenIR": {
    "schema": "schema/sui.schema.json",
    "componentIndex": "index.json",
    "patternIndex": "patterns/index.json",
    "requiresValidation": true,
    "onError": "reject",
    "onWarning": "show-diagnostic",
    "allowedComponentStatus": "authored-with-props-and-ir",
    "unverifiedBlocks": {
      "default": "reject",
      "enabledBy": "host-render-option",
      "isolation": "sandboxed-frame-without-scripts-network-forms-or-navigation",
      "canRequestActions": false,
      "label": "always-shown"
    }
  },
  "actions": {
    "authorizationOwner": "host-application",
    "default": "deny",
    "modelAuthoredApprovalIsAuthorization": false,
    "requiresTrustedScopeCheck": true
  }
}
