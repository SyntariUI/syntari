{
  "$schema": "../schema/component.schema.json",
  "id": "approval-card",
  "version": "1.0.0",
  "status": "authored",
  "source": "components/approval-card/",
  "name": "Approval card",
  "category": "Agents",
  "purpose": "Summarize a completed piece of work and ask for a decision on it.",
  "description": "A review surface with the summary, the affected detail, and explicit approve or decline actions.",
  "intents": [
    "review",
    "approve",
    "reject",
    "confirm"
  ],
  "variants": {
    "risk": [
      "low",
      "moderate",
      "high"
    ]
  },
  "states": [
    "pending",
    "approved",
    "declined"
  ],
  "anatomy": [
    "root",
    "icon",
    "title",
    "decision",
    "summary",
    "detail",
    "footer",
    "approve",
    "decline"
  ],
  "accessibility": {
    "role": "group",
    "keyboard": [
      "Tab",
      "Enter",
      "Space"
    ],
    "accessibleNameRequired": true
  },
  "rules": [
    "summary-states-what-changed",
    "detail-states-where",
    "decision-is-explicit"
  ],
  "tokens": [
    "color.surface.raised",
    "color.border.default",
    "color.text.primary",
    "color.text.secondary",
    "color.action.primary",
    "radius.card",
    "space.4"
  ],
  "compatibleWith": [
    "file-diff",
    "activity-list",
    "metadata-list"
  ],
  "avoidWhen": [
    "nothing-has-been-produced-yet"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "required": true,
      "maxLength": 160,
      "description": "What was produced."
    },
    "detail": {
      "type": "string",
      "required": true,
      "maxLength": 120,
      "description": "Where the change lands."
    },
    "hint": {
      "type": "string",
      "maxLength": 120
    },
    "icon": {
      "type": "string",
      "default": "circlecheck",
      "maxLength": 24
    },
    "approveLabel": {
      "type": "string",
      "default": "Approve",
      "maxLength": 24
    },
    "rejectLabel": {
      "type": "string",
      "default": "Decline",
      "maxLength": 24
    }
  },
  "ir": {
    "node": ".agent-surface",
    "icon": {
      "icon": ".agent-heading .icon"
    },
    "lead": {
      "title": ".agent-heading strong",
      "detail": ".agent-inset",
      "approveLabel": ".agent-footer [data-agent-action=approve]",
      "rejectLabel": ".agent-footer [data-agent-action=reject]"
    },
    "text": {
      "summary": ".agent-surface > p",
      "hint": ".agent-surface > p.hint"
    }
  }
}
