{
  "$schema": "../schema/component.schema.json",
  "id": "metric-strip",
  "version": "1.0.0",
  "status": "authored",
  "sample": {
    "props": {
      "items": [
        {
          "label": "Mention rate",
          "icon": "eye",
          "value": "45.4%",
          "delta": "3.3 pp",
          "direction": "up",
          "meaning": "of answers"
        },
        {
          "label": "Leads",
          "icon": "star",
          "value": "2",
          "direction": "down"
        }
      ]
    }
  },
  "source": "components/metric-strip/",
  "name": "Metric tabs",
  "category": "Metrics",
  "purpose": "Let one measure be the focus of a report.",
  "description": "A row of measures where the active one is the thing being charted, and choosing another changes the focus.",
  "intents": [
    "choose-measure",
    "report-numbers"
  ],
  "variants": {
    "measures": [
      "1 to 6"
    ]
  },
  "states": [
    "default",
    "selected"
  ],
  "anatomy": [
    "root",
    "item",
    "label",
    "value",
    "change",
    "meaning"
  ],
  "accessibility": {
    "role": "group",
    "keyboard": [
      "Tab",
      "Enter",
      "Space"
    ],
    "accessibleNameRequired": false
  },
  "rules": [
    "one-measure-is-active",
    "the-change-names-its-unit",
    "the-meaning-explains-the-number"
  ],
  "tokens": [
    "color.surface.raised",
    "color.surface.subtle",
    "color.border.default",
    "color.text.primary",
    "color.text.secondary",
    "color.status.success"
  ],
  "compatibleWith": [
    "area-chart",
    "chart-toolbar",
    "headline-metric"
  ],
  "avoidWhen": [
    "the-measures-are-not-alternatives"
  ],
  "props": {
    "items": {
      "type": "array",
      "required": true,
      "maxItems": 6,
      "items": {
        "type": "object",
        "fields": {
          "label": {
            "type": "string",
            "maxLength": 24,
            "required": true
          },
          "icon": {
            "type": "string",
            "maxLength": 24
          },
          "value": {
            "type": "string",
            "maxLength": 12,
            "required": true
          },
          "delta": {
            "type": "string",
            "maxLength": 12
          },
          "direction": {
            "type": "enum",
            "values": [
              "up",
              "down",
              "none"
            ],
            "default": "up"
          },
          "meaning": {
            "type": "string",
            "maxLength": 40
          },
          "active": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "ir": {
    "node": ".metric-strip",
    "list": {
      "items": {
        "container": ".metric-strip",
        "item": ".metric-item",
        "lead": {
          "label": ".metric-label"
        },
        "icon": {
          "icon": ".metric-label .icon"
        },
        "text": {
          "value": ".metric-value",
          "delta": ".metric-delta",
          "meaning": ".metric-meaning"
        },
        "variant": {
          "direction": {
            "selector": ".metric-delta",
            "values": {
              "up": "up",
              "down": "down",
              "none": ""
            }
          }
        },
        "class": {
          "active": "active"
        },
        "attributes": {
          "active": {
            "selector": "",
            "attribute": "aria-pressed"
          }
        }
      }
    }
  },
  "actions": {
    "select": {
      "selector": "[data-metric]",
      "local": true,
      "description": "The person chose the measure to chart. index says which; the host charts it."
    }
  },
  "guidance": {
    "summary": "A row of measures where choosing one makes it the focus of the analysis below.",
    "useWhen": [
      "One chart shows one measure at a time, and people switch which measure it shows.",
      "The measures are alternatives views of the same subject, such as rate, volume, and conversion."
    ],
    "avoidWhen": [
      {
        "text": "The measures are independent headlines, not alternatives to chart.",
        "instead": "stat-row"
      },
      {
        "text": "The screen's job is to resolve or review work.",
        "instead": "table"
      }
    ],
    "states": [
      {
        "id": "default",
        "label": "Default",
        "description": "A strip of measures; the active one is marked and pressed.",
        "how": "items, one with active: true"
      },
      {
        "id": "selected",
        "label": "Selected",
        "description": "Choosing another measure makes it active and reports it to the host.",
        "how": "Press a measure."
      }
    ],
    "dos": [
      {
        "title": "One active measure",
        "description": "The strip says which measure the chart below is showing."
      },
      {
        "title": "Meaning under each value",
        "description": "of sampled answers, distinct sources: what the number counts."
      }
    ],
    "donts": [
      {
        "title": "A strip with nothing to drive",
        "description": "Without a chart that follows it, it is a stat row that looks clickable."
      },
      {
        "title": "Beside another metrics block",
        "description": "Two rows of headline numbers compete."
      }
    ],
    "content": [
      "Labels name the measure, not the chart."
    ],
    "accessibility": {
      "keyboard": [
        {
          "keys": "Tab",
          "action": "Moves between measures."
        },
        {
          "keys": "Enter or Space",
          "action": "Makes the focused measure active."
        }
      ],
      "notes": [
        "Each measure is a toggle button; the active one is pressed.",
        "Changes are written with their sign, not only a colour."
      ]
    },
    "composition": {
      "surface": "card",
      "defaultVisible": "Every measure with its value, change, and meaning.",
      "density": "Up to six measures; past four they wrap.",
      "contentLength": "Labels under 20 characters.",
      "redundantWith": [
        {
          "component": "stat-row",
          "reason": "Two blocks of headline measures."
        }
      ],
      "archetypes": {
        "fits": [
          "monitoring-dashboard"
        ],
        "avoid": [
          "task-triage",
          "record-workspace",
          "evidence-review",
          "configuration-workspace"
        ]
      },
      "mistakes": [
        "A strip above no chart.",
        "Measures that are not alternatives."
      ],
      "responsive": "Measures wrap two by two; the active one stays visible."
    }
  }
}
