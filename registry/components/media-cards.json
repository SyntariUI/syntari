{
  "$schema": "../schema/component.schema.json",
  "id": "media-cards",
  "version": "1.0.0",
  "status": "authored",
  "sample": {
    "props": {
      "items": [
        {
          "title": "Starter",
          "description": "For teams trying the product.",
          "icon": "smile"
        },
        {
          "title": "Business",
          "description": "For teams that run on it every day.",
          "icon": "layers"
        },
        {
          "title": "Enterprise",
          "description": "For companies that need SSO and audit logs.",
          "icon": "lock"
        }
      ]
    }
  },
  "source": "components/media-cards/",
  "name": "Media cards",
  "category": "Cards",
  "purpose": "Introduce a few kinds of thing side by side, each with a picture and a caption.",
  "description": "A short row of cards, each with artwork, a title, and a caption. Images come only from the host; without one a card shows its icon.",
  "intents": [
    "explain",
    "introduce",
    "compare-kinds"
  ],
  "variants": {
    "cards": [
      "2 to 4"
    ],
    "art": [
      "host image",
      "icon"
    ]
  },
  "states": [
    "default"
  ],
  "anatomy": [
    "root",
    "card",
    "art",
    "image",
    "icon",
    "title",
    "caption"
  ],
  "accessibility": {
    "role": "list",
    "keyboard": [],
    "accessibleNameRequired": false
  },
  "rules": [
    "images-come-from-the-host",
    "the-caption-says-what-the-image-shows",
    "cards-are-peers"
  ],
  "tokens": [
    "color.surface.subtle",
    "color.text.primary",
    "color.text.secondary",
    "radius.card"
  ],
  "compatibleWith": [
    "text-block",
    "breakdown",
    "comparison-table"
  ],
  "avoidWhen": [
    "the-cards-need-actions",
    "more-than-four-kinds"
  ],
  "props": {
    "items": {
      "type": "array",
      "required": true,
      "maxItems": 4,
      "items": {
        "type": "object",
        "fields": {
          "title": {
            "type": "string",
            "required": true,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "maxLength": 140
          },
          "icon": {
            "type": "string",
            "maxLength": 24,
            "default": "image",
            "description": "Syntari icon shown when there is no image."
          },
          "image": {
            "type": "string",
            "maxLength": 64,
            "description": "Id of an image the host provides through the assets option. Never a URL."
          },
          "alt": {
            "type": "string",
            "maxLength": 120,
            "description": "What the image shows, for people who cannot see it."
          }
        }
      }
    }
  },
  "ir": {
    "node": ".media-cards",
    "list": {
      "items": {
        "container": ".media-cards",
        "item": ".media-card",
        "text": {
          "title": ".media-card-title",
          "description": ".media-card-copy"
        },
        "icon": {
          "icon": ".media-card-icon"
        },
        "image": {
          "image": {
            "selector": ".media-card-image",
            "alt": "alt"
          }
        }
      }
    }
  }
}
