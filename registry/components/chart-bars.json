{
  "$schema": "../schema/component.schema.json",
  "id": "chart-bars",
  "version": "1.0.0",
  "status": "authored",
  "sample": {
    "props": {
      "title": "Runs by period",
      "note": "Indexed",
      "seriesA": "This week",
      "seriesB": "Last",
      "chartLabel": "Runs by period, this week against last: Mon 41 vs 30",
      "columns": [
        {
          "label": "Mon",
          "a": 41,
          "b": 30
        }
      ]
    }
  },
  "source": "components/chart-bars/",
  "name": "Chart bars",
  "category": "Data display",
  "purpose": "Compare two series across the same checkpoints.",
  "description": "Columns or bars for one or two series on a shared scale, with a legend and a summary a screen reader can read.",
  "intents": [
    "compare",
    "rank",
    "show-ordered-buckets",
    "report-trend"
  ],
  "variants": {
    "series": [
      "one",
      "two"
    ],
    "points": [
      "up to 12"
    ],
    "orientation": [
      "horizontal",
      "vertical"
    ]
  },
  "states": [
    "default"
  ],
  "anatomy": [
    "root",
    "caption",
    "column",
    "value",
    "legend"
  ],
  "accessibility": {
    "role": "img",
    "keyboard": [],
    "accessibleNameRequired": true
  },
  "rules": [
    "both-series-share-a-scale",
    "the-summary-states-the-numbers",
    "never-rely-on-colour-alone",
    "buckets-keep-their-order"
  ],
  "tokens": [
    "color.action.primary",
    "color.text.primary",
    "color.text.secondary",
    "color.border.default",
    "motion.duration.data"
  ],
  "compatibleWith": [
    "card",
    "stat-row",
    "comparison-table"
  ],
  "avoidWhen": [
    "the-series-need-different-scales",
    "a-trend-over-many-periods",
    "parts-of-one-whole-that-sum-to-100"
  ],
  "props": {
    "title": {
      "type": "string",
      "maxLength": 60,
      "required": true
    },
    "note": {
      "type": "string",
      "maxLength": 60
    },
    "orientation": {
      "type": "enum",
      "values": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal",
      "description": "vertical draws columns, for ordered buckets such as a liquidity or maturity ladder; horizontal draws bars, for ranked or compared categories."
    },
    "unit": {
      "type": "enum",
      "values": [
        "",
        "%",
        "pp"
      ],
      "default": "",
      "description": "Written after each value."
    },
    "seriesA": {
      "type": "string",
      "maxLength": 24
    },
    "seriesB": {
      "type": "string",
      "maxLength": 24,
      "description": "Name of the second series. Leave it and every b out for one series."
    },
    "chartLabel": {
      "type": "string",
      "maxLength": 160,
      "description": "What a screen reader hears instead of the bars, so include the values, such as 'Runs by day, this week against last: Mon 41 vs 30'.",
      "required": true
    },
    "columns": {
      "type": "array",
      "required": true,
      "maxItems": 12,
      "items": {
        "type": "object",
        "fields": {
          "label": {
            "type": "string",
            "maxLength": 16,
            "required": true,
            "description": "Up to 6 characters reads best in vertical columns; horizontal bars fit up to 16, such as an asset class."
          },
          "a": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "required": true,
            "description": "The first series, 0 to 100: a share or an index."
          },
          "b": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "The second series on the same scale. Leave it out for one series."
          }
        }
      },
      "description": "Categories in display order: buckets in their natural order, ranked categories largest first. Bars are drawn against the largest value, and each label shows its values."
    }
  },
  "ir": {
    "node": ".chart-figure",
    "text": {
      "title": ".chart-figure figcaption strong",
      "note": ".chart-figure figcaption .hint"
    },
    "lead": {
      "seriesA": ".chart-legend li:nth-child(1)",
      "seriesB": ".chart-legend li:nth-child(2)"
    },
    "attributes": {
      "chartLabel": {
        "selector": ".chart-columns",
        "attribute": "aria-label"
      }
    },
    "list": {
      "columns": {
        "container": ".chart-columns",
        "item": ".chart-column",
        "text": {
          "label": ".column-label",
          "a": {
            "selector": ".column-value",
            "suffixFrom": "unit",
            "joinField": "b"
          }
        },
        "style": {
          "a": {
            "selector": ".column-fill.series-a",
            "name": "--fill",
            "suffix": "%",
            "scaleGroup": "bars"
          },
          "b": {
            "selector": ".column-fill.series-b",
            "name": "--fill",
            "suffix": "%",
            "removeWhenEmpty": true,
            "scaleGroup": "bars"
          }
        }
      }
    },
    "variant": {
      "orientation": {
        "selector": "",
        "values": {
          "horizontal": "chart-bars-modern",
          "vertical": "chart-bars-vertical"
        }
      }
    }
  }
}
