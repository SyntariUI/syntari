{
  "$id": "https://syntari.dev/registry/tokens/semantic.json",
  "version": "0.2.1",
  "description": "Meaningful token roles. Each maps to a primitive and compiles to a CSS variable.",
  "tokens": {
    "color.surface.canvas": { "primitive": "neutral.canvas", "css": "--canvas" },
    "color.surface.raised": { "primitive": "neutral.surface", "css": "--surface" },
    "color.surface.subtle": { "primitive": "neutral.subtle", "css": "--subtle" },
    "color.surface.dock": { "primitive": "neutral.dock", "css": "--dock-surface" },
    "color.text.primary": { "primitive": "neutral.text", "css": "--text" },
    "color.text.secondary": { "primitive": "neutral.muted", "css": "--muted" },
    "color.text.disabled": { "primitive": "neutral.fg2", "css": "--fg-2" },
    "color.border.default": { "primitive": "neutral.border", "css": "--border" },
    "color.action.primary": { "primitive": "purple.400", "css": "--accent" },
    "color.action.primary.soft": { "primitive": "purple.400", "css": "--accent-soft" },
    "color.action.primary.text": { "primitive": "purple.text", "css": "--accent-text" },
    "color.status.success": { "primitive": "green.text", "css": "--success-text" },
    "color.status.danger": { "primitive": "red.text", "css": "--danger-text" },
    "color.status.warning": { "primitive": "amber.text", "css": "--warning-text" },
    "color.focus.ring": { "primitive": "purple.text", "css": "--focus-ring" },
    "radius.control": { "primitive": "radius.full", "css": "--radius-control" },
    "radius.card": { "primitive": "radius.lg", "css": "--radius-card" },
    "radius.1": { "primitive": "radius.1", "css": "--radius-1" },
    "radius.2": { "primitive": "radius.2", "css": "--radius-2" },
    "radius.3": { "primitive": "radius.3", "css": "--radius-3" },
    "radius.4": { "primitive": "radius.4", "css": "--radius-4" },
    "radius.5": { "primitive": "radius.5", "css": "--radius-5" },
    "radius.6": { "primitive": "radius.6", "css": "--radius-6" },
    "motion.duration.fast": { "primitive": "motion.fast", "css": "--motion-fast" },
    "motion.duration.medium": { "primitive": "motion.medium", "css": "--motion-medium" },
    "motion.duration.panel": { "primitive": "motion.panel", "css": "--motion-panel" },
    "motion.duration.data": { "primitive": "motion.data", "css": "--motion-data" },
    "motion.easing.out": { "primitive": "motion.ease-out", "css": "--ease-out" },
    "motion.easing.spring": { "primitive": "motion.ease-spring", "css": "--ease-spring" },
    "space.1": { "primitive": "space.1", "css": "--space-1" },
    "space.2": { "primitive": "space.2", "css": "--space-2" },
    "space.3": { "primitive": "space.3", "css": "--space-3" },
    "space.4": { "primitive": "space.4", "css": "--space-4" },
    "space.5": { "primitive": "space.5", "css": "--space-5" },
    "space.6": { "primitive": "space.6", "css": "--space-6" },
    "space.7": { "primitive": "space.7", "css": "--space-7" },
    "shadow.soft": { "primitive": "shadow.soft", "css": "--shadow-soft" },
    "shadow.card": { "primitive": "shadow.card", "css": "--shadow-card" },
    "shadow.card.hover": { "primitive": "shadow.card-hover", "css": "--shadow-card-hover" },
    "font.sans": { "primitive": "font.sans", "css": "--font-sans" }
  }
}
