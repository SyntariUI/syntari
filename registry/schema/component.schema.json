{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syntariui.giovanitier.com/registry/schema/component.schema.json",
  "title": "SyntariComponent",
  "description": "Machine-readable contract for one Syntari component or agent pattern.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category",
    "purpose",
    "variants",
    "states",
    "anatomy",
    "accessibility",
    "tokens"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anatomy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "role",
        "keyboard",
        "accessibleNameRequired"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibleNameRequired": {
          "type": "boolean"
        },
        "liveRegion": {
          "type": "string"
        },
        "focusTrap": {
          "type": "boolean"
        },
        "focusRestoration": {
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "props": {
      "type": "object",
      "description": "Prop contract an agent may set through the Syntari UI IR. Absent means the component is documented but not yet renderable from IR.",
      "additionalProperties": {
        "$ref": "#/definitions/prop"
      }
    },
    "ir": {
      "type": "object",
      "description": "Maps validated props onto the component's own markup. The renderer mounts the component, keeps the node this declares, then writes prop values into the declared slots.",
      "properties": {
        "node": {
          "type": "string",
          "description": "Instance root inside the mounted component. Everything else in the mounted element is discarded."
        },
        "text": {
          "$ref": "#/definitions/selectorMap"
        },
        "lead": {
          "$ref": "#/definitions/selectorMap"
        },
        "icon": {
          "$ref": "#/definitions/selectorMap"
        },
        "variant": {
          "type": "object",
          "description": "Prop name to the classes it sets. A list of bindings sets classes in several places from one value, such as a status badge and the dot beside it.",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/variantBinding"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/variantBinding"
                },
                "minItems": 1
              }
            ]
          }
        },
        "class": {
          "type": "object",
          "description": "Prop name to class name. A truthy value adds the class, a false value removes it.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "series": {
          "type": "object",
          "description": "Numeric series drawn as SVG paths, so a chart is data rather than markup.",
          "additionalProperties": {
            "$ref": "#/definitions/seriesBinding"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/attributeBinding"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/attributeBinding"
                },
                "minItems": 1
              }
            ]
          }
        },
        "list": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/listPart"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/listPart"
                }
              }
            ]
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Selectors for demo-only parts removed from a contract instance."
        },
        "showWhen": {
          "description": "Prop name to an element that only means something beside that value, such as a Total label or a picker without options. The element is hidden while the prop is unset, empty, or an empty list.",
          "allOf": [
            {
              "$ref": "#/definitions/selectorMap"
            }
          ]
        },
        "select": {
          "type": "object",
          "description": "Prop name to the list item it selects: the item whose field equals the prop gets the attribute, such as aria-selected.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "list",
              "field",
              "attribute"
            ],
            "properties": {
              "list": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "attribute": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "compute": {
          "type": "object",
          "description": "A computing contract. Inputs are range controls; each output and part is a formula over input names and earlier output names, parsed without running code. The renderer recomputes as a person moves an input.",
          "required": [
            "inputs",
            "outputs",
            "control",
            "input",
            "readout",
            "result",
            "value"
          ],
          "properties": {
            "inputs": {
              "type": "string"
            },
            "outputs": {
              "type": "string"
            },
            "parts": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "control": {
              "type": "string"
            },
            "input": {
              "type": "string"
            },
            "readout": {
              "type": "string"
            },
            "min": {
              "type": "string"
            },
            "max": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "segment": {
              "type": "string"
            },
            "part": {
              "type": "string"
            },
            "partValue": {
              "type": "string"
            },
            "partShare": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sort": {
          "type": "object",
          "description": "A sortable table: the boolean prop turns each heading into a sort button. Columns of figures align on the right either way.",
          "required": [
            "prop"
          ],
          "properties": {
            "prop": {
              "type": "string"
            },
            "header": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "compatibleWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoidWhen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mayContain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "object",
          "properties": {
            "primaryMax": {
              "type": "integer"
            },
            "destructiveRequiresConfirmation": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "density": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attention": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "risk": {
          "type": "string"
        },
        "interaction": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reversibility": {
          "type": "string"
        },
        "ownership": {
          "type": "string"
        }
      }
    },
    "examples": {
      "type": "object",
      "properties": {
        "good": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bad": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "string"
    },
    "status": {
      "enum": [
        "authored",
        "generated",
        "draft"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "object",
      "description": "Things a person can ask for from this component. In contract mode (Screen IR or mount with props) a declared action never runs demo behaviour: it fires a syntari:action event and the host decides what happens.",
      "additionalProperties": {
        "$ref": "#/definitions/action"
      }
    },
    "sample": {
      "type": "object",
      "description": "A complete, valid props object. Agents can start from it; tests render it.",
      "required": [
        "props"
      ],
      "properties": {
        "props": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "prop": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "values": {
          "type": "array"
        },
        "default": {},
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "$ref": "#/definitions/prop"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/prop"
          }
        },
        "sum": {
          "type": "object",
          "description": "For a list whose items are parts of one whole: the named number field must add up to total, within tolerance.",
          "required": [
            "field",
            "total"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "total": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "defaultFrom": {
          "type": "object",
          "description": "For a field of a list item: when the item leaves the field out, its value is taken from another field of the same item, such as a stage's mark from its state. The other field's own default applies first; a value with no mapping falls back to default.",
          "required": [
            "field",
            "values"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selectorMap": {
      "type": "object",
      "description": "Prop name to CSS selector, resolved inside the instance root or the list item.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          {
            "type": "object",
            "required": [
              "selector"
            ],
            "properties": {
              "selector": {
                "type": "string"
              },
              "suffixFrom": {
                "type": "string",
                "description": "Prop whose value is written after the text, such as a unit."
              },
              "joinField": {
                "type": "string",
                "description": "A second field of the same item written after the first, such as the other series of a bar."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "variantBinding": {
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "selector": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "styleBinding": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "removeWhenEmpty": {
          "type": "boolean",
          "description": "Remove the element when the item leaves the field out, such as the second bar of a single-series chart."
        },
        "scaleGroup": {
          "type": "string",
          "description": "Fields that share a group are drawn against the largest value among them."
        }
      },
      "additionalProperties": false
    },
    "attributeBinding": {
      "type": "object",
      "required": [
        "selector",
        "attribute"
      ],
      "properties": {
        "selector": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "invert": {
          "type": "boolean",
          "description": "Write the opposite of the prop value, such as disabled when streaming is false."
        },
        "fallback": {
          "type": "string",
          "description": "Prop whose value is used when this prop is unset, such as a chart label that falls back to the title."
        }
      },
      "additionalProperties": false,
      "description": "Writes a prop into an attribute. When the prop and its fallback are unset, the template attribute is removed."
    },
    "seriesBinding": {
      "type": "object",
      "required": [
        "selector"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "description": "The SVG that owns the geometry."
        },
        "line": {
          "type": "string",
          "description": "Path that receives the stroked line."
        },
        "fill": {
          "type": "string",
          "description": "Path that receives the same series closed to the baseline."
        },
        "viewBox": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "Field of each point that carries the number. Defaults to value."
        },
        "inset": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            },
            "right": {
              "type": "number"
            }
          }
        },
        "scale": {
          "description": "Fixed bounds, or \"auto\" for round bounds that fit the data.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            {
              "const": "auto"
            }
          ]
        },
        "label": {
          "type": "string",
          "description": "Field of each point that carries its label. Defaults to label."
        },
        "unit": {
          "type": "string",
          "description": "Suffix shown after each value, such as %."
        },
        "markers": {
          "type": "string",
          "description": "Point marker inside the SVG. The first is cloned for every point; the demo markers are removed."
        },
        "markerText": {
          "type": "string",
          "description": "Text inside a marker that shows its label and value."
        },
        "grid": {
          "type": "string",
          "description": "Grid lines inside the SVG, top to bottom, placed on the axis ticks."
        },
        "axis": {
          "type": "string",
          "description": "Axis labels, top to bottom, written from the scale."
        },
        "ticks": {
          "type": "string",
          "description": "Labels along the series, written from evenly spaced points."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "description": "Several lines drawn from one list, one field each, on one shared scale.",
          "items": {
            "type": "object",
            "required": [
              "field",
              "line"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "fill": {
                "type": "string"
              },
              "optional": {
                "type": "boolean",
                "description": "Not drawn when no point carries the field."
              },
              "nameFrom": {
                "type": "string",
                "description": "Prop that names this series in each point’s reading."
              }
            },
            "additionalProperties": false
          }
        },
        "unitFrom": {
          "type": "string",
          "description": "Prop whose value is the unit, overriding unit."
        },
        "includeZero": {
          "type": "boolean",
          "description": "Keep zero inside the automatic scale."
        },
        "zero": {
          "type": "string",
          "description": "Line placed at zero when the scale crosses it, hidden otherwise."
        },
        "placeAxis": {
          "type": "boolean",
          "description": "Position each axis label level with its gridline."
        },
        "markerBox": {
          "type": "string",
          "description": "Shape behind a marker’s text, sized to fit it."
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "line"
          ]
        },
        {
          "required": [
            "lines"
          ]
        }
      ]
    },
    "listPart": {
      "type": "object",
      "required": [
        "container",
        "item"
      ],
      "properties": {
        "container": {
          "type": "string"
        },
        "item": {
          "type": "string",
          "description": "Template node. The first match is cloned for every item and the demo copies are removed."
        },
        "text": {
          "$ref": "#/definitions/selectorMap"
        },
        "lead": {
          "$ref": "#/definitions/selectorMap"
        },
        "icon": {
          "$ref": "#/definitions/selectorMap"
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/variantBinding"
          }
        },
        "class": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/attributeBinding"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/attributeBinding"
                },
                "minItems": 1
              }
            ]
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/styleBinding"
          }
        },
        "strip": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Demo-only attributes removed from generated items."
        },
        "cells": {
          "type": "string"
        },
        "cellCount": {
          "type": "string",
          "description": "Array prop whose length sets the number of cells in each item, such as table columns."
        },
        "image": {
          "type": "object",
          "description": "Field name to an img element. The field names an image the host provides through the assets option; any other value leaves the image hidden and reports unknown-asset.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "selector"
            ],
            "properties": {
              "selector": {
                "type": "string"
              },
              "alt": {
                "type": "string",
                "description": "Field that holds the image's text alternative."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "selector"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "description": "Element inside the instance that carries the action."
        },
        "event": {
          "enum": [
            "click",
            "submit",
            "change"
          ],
          "default": "click",
          "description": "submit sends the form's named values; change sends a checkbox's checked or a field's value."
        },
        "description": {
          "type": "string"
        },
        "consequential": {
          "type": "boolean",
          "description": "True when acting on it changes something outside the screen. The host must authorise it."
        },
        "consequentialProp": {
          "type": "string",
          "description": "Boolean prop that marks this instance's requests consequential, such as a Delete button."
        },
        "local": {
          "type": "boolean",
          "default": false,
          "description": "The component also updates itself, as a view control does. The request reports its new state (value, checked, or pressed) so the host can update the data."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
