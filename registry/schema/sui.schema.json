{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syntariui.github.io/syntari/registry/schema/sui.schema.json",
  "title": "SyntariUI",
  "description": "Syntari UI IR: a constrained, renderer-agnostic description of a screen.",
  "oneOf": [
    { "$ref": "#/definitions/screen" },
    { "$ref": "#/definitions/node" }
  ],
  "definitions": {
    "node": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "type": "string" },
        "slot": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        },
        "provenance": { "$ref": "#/definitions/provenance" }
      },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "screen" },
        "layout": { "type": "string" },
        "title": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        },
        "meta": { "type": "object" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "component": { "type": "string" },
        "source": { "type": "string" },
        "reason": { "type": "string" },
        "rulesApplied": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
