{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syntariui.giovanitier.com/registry/schema/sui.schema.json",
  "title": "SyntariUI",
  "description": "Syntari UI IR: a constrained, renderer-agnostic description of a screen. Component ids must resolve against the published registry; layout is limited to the set the reference renderer implements. Sections group nodes under a heading, regions group them in a disclosure, and unverified blocks hold static HTML only when the host allows them.",
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^syntari\\.[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Registry component id in syntari.<slug> form. Referential checks happen at the boundary against registry/index.json."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Unique within the screen. Action events carry it so the host can match a request to its own state."
        },
        "slot": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "description": "A labelled disclosure. The label is what a person reads; open decides whether the contents start visible.",
      "required": [
        "type",
        "label",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Unique within the screen. Operations name nodes by id."
        },
        "type": {
          "const": "region"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "open": {
          "type": "boolean",
          "default": false
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "region"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/region"
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "section"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/section"
          },
          "else": {
            "if": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "sandbox"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/sandbox"
            },
            "else": {
              "$ref": "#/definitions/node"
            }
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "version": {
          "const": "syntari-ir-1"
        },
        "type": {
          "const": "screen"
        },
        "layout": {
          "type": "string",
          "default": "stack",
          "description": "One of stack, row, grid, or two-column. An unknown layout produces a warning and renders as stack."
        },
        "title": {
          "type": "string"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "meta": {
          "type": "object"
        },
        "data": {
          "$ref": "#/definitions/data"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rulesApplied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "description": "A heading over a group of nodes that keeps its own layout. Unlike a region it never collapses; use it for the numbered parts of an answer. With a submit label, the section is a form.",
      "required": [
        "type",
        "heading",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Unique within the screen. Operations name nodes by id."
        },
        "type": {
          "const": "section"
        },
        "heading": {
          "type": "string",
          "maxLength": 80
        },
        "layout": {
          "type": "string",
          "default": "stack",
          "description": "One of stack, row, grid, or two-column. An unknown layout produces a warning and renders as stack."
        },
        "submit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Makes the section a form: the label of its one submit button, such as \"Send invite\". Submitting sends every field inside as one action request, {component: \"form\", action: \"submit\", id, values}. Forms do not nest."
        },
        "consequential": {
          "type": "boolean",
          "default": false,
          "description": "With submit: the request changes something that is hard to undo, so the host should confirm before it runs."
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "description": "Unverified, model-written static HTML. The renderer rejects it unless the host allows unverified blocks; when allowed it renders in an isolated frame with no scripts, no network, no forms, and no actions, and is always labelled as unverified.",
      "required": [
        "type",
        "label",
        "html"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Unique within the screen. Operations name nodes by id."
        },
        "type": {
          "const": "sandbox"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "html": {
          "type": "string",
          "maxLength": 20000
        },
        "height": {
          "type": "number",
          "minimum": 80,
          "maximum": 1200,
          "default": 320
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "description": "The screen's canonical data. Components bind props to it with { \"$data\": \"measures.<name>\" | \"groups.<name>\" | \"tables.<name>\" }, and the runtime computes every bound figure from the rows, so text, charts, and tables cannot disagree.",
      "properties": {
        "mode": {
          "enum": [
            "demo",
            "provided"
          ],
          "description": "demo figures are labelled on the screen as demonstration data."
        },
        "label": {
          "type": "string",
          "maxLength": 140
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "locale": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "tables": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "object",
            "required": [
              "fields",
              "rows"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "maxProperties": 16,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "text",
                        "category",
                        "period",
                        "date",
                        "number",
                        "percent",
                        "currency",
                        "days"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "total": {
                      "type": "number"
                    },
                    "role": {
                      "enum": [
                        "allocation",
                        "exposure",
                        "risk-contribution",
                        "volatility",
                        "return",
                        "benchmark",
                        "value",
                        "liquidity",
                        "count",
                        "other"
                      ]
                    },
                    "order": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "measures": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "type": "object",
            "required": [
              "label"
            ]
          }
        },
        "groups": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "object",
            "required": [
              "table",
              "by"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "if": {
    "type": "object",
    "required": [
      "type"
    ],
    "properties": {
      "type": {
        "const": "screen"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/screen"
  },
  "else": {
    "if": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "region"
        }
      }
    },
    "then": {
      "$ref": "#/definitions/region"
    },
    "else": {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "section"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/section"
      },
      "else": {
        "if": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "sandbox"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/sandbox"
        },
        "else": {
          "$ref": "#/definitions/node"
        }
      }
    }
  }
}
