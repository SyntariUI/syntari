{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syntariui.giovanitier.com/registry/schema/sui.schema.json",
  "title": "SyntariUI",
  "description": "Syntari UI IR: a constrained, renderer-agnostic description of a screen. Component ids must resolve against the published registry; layout is limited to the set the reference renderer implements. Sections group nodes under a heading, regions group them in a disclosure, and unverified blocks hold static HTML only when the host allows them.",
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^syntari\\.[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Registry component id in syntari.<slug> form. Referential checks happen at the boundary against registry/index.json."
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "description": "Unique within the screen. Action events carry it so the host can match a request to its own state."
        },
        "slot": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "description": "A labelled disclosure. The label is what a person reads; open decides whether the contents start visible.",
      "required": [
        "type",
        "label",
        "children"
      ],
      "properties": {
        "type": {
          "const": "region"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "open": {
          "type": "boolean",
          "default": false
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "region"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/region"
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "section"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/section"
          },
          "else": {
            "if": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "sandbox"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/sandbox"
            },
            "else": {
              "$ref": "#/definitions/node"
            }
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "version": {
          "const": "syntari-ir-1"
        },
        "type": {
          "const": "screen"
        },
        "layout": {
          "type": "string",
          "default": "stack",
          "description": "One of stack, row, grid, or two-column. An unknown layout produces a warning and renders as stack."
        },
        "title": {
          "type": "string"
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rulesApplied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "description": "A heading over a group of nodes that keeps its own layout. Unlike a region it never collapses; use it for the numbered parts of an answer.",
      "required": [
        "type",
        "heading",
        "children"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "heading": {
          "type": "string",
          "maxLength": 80
        },
        "layout": {
          "type": "string",
          "default": "stack",
          "description": "One of stack, row, grid, or two-column. An unknown layout produces a warning and renders as stack."
        },
        "children": {
          "$ref": "#/definitions/children"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "description": "Unverified, model-written static HTML. The renderer rejects it unless the host allows unverified blocks; when allowed it renders in an isolated frame with no scripts, no network, no forms, and no actions, and is always labelled as unverified.",
      "required": [
        "type",
        "label",
        "html"
      ],
      "properties": {
        "type": {
          "const": "sandbox"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "html": {
          "type": "string",
          "maxLength": 20000
        },
        "height": {
          "type": "number",
          "minimum": 80,
          "maximum": 1200,
          "default": 320
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    }
  },
  "if": {
    "type": "object",
    "required": [
      "type"
    ],
    "properties": {
      "type": {
        "const": "screen"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/screen"
  },
  "else": {
    "if": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "region"
        }
      }
    },
    "then": {
      "$ref": "#/definitions/region"
    },
    "else": {
      "if": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "section"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/section"
      },
      "else": {
        "if": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "sandbox"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/sandbox"
        },
        "else": {
          "$ref": "#/definitions/node"
        }
      }
    }
  }
}
