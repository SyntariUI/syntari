{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntariui.github.io/syntari/registry/schema/patterns.schema.json",
  "title": "Syntari Pattern Registry",
  "type": "object",
  "required": [
    "version",
    "patterns"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "description",
          "dependencies",
          "tokens",
          "files",
          "examples",
          "installable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "layout",
              "interaction",
              "composition"
            ]
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
