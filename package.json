{
  "name": "syntari-ui",
  "version": "0.2.3",
  "private": false,
  "description": "A design system for people and agents. 131 components, a machine-readable registry, and a renderer that validates what agents compose.",
  "homepage": "https://syntariui.giovanitier.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyntariUI/syntari.git"
  },
  "keywords": [
    "design-system",
    "agent-ui",
    "components",
    "registry",
    "renderer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test",
    "figma:extract": "node scripts/extract-figma.mjs",
    "deploy": "wrangler deploy",
    "test:browser": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "wrangler": "4.138.0"
  },
  "bin": {
    "syntari": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "agent.mjs",
    "registry-validator.mjs",
    "kit/",
    "README.md",
    "LICENSE",
    "AGENT-GUIDE.md"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "type": "module",
  "main": "./agent.mjs",
  "exports": {
    ".": "./agent.mjs",
    "./registry/*": "./kit/runtime/registry/*",
    "./runtime/*": "./kit/runtime/*",
    "./package.json": "./package.json"
  }
}
